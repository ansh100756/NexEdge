# Browser-visible values. Keep these relative when using the Vercel proxy.
VITE_API_BASE_URL=/api
VITE_CDN_BASE_URL=/cdn
VITE_CDN_MODE=local

# Vercel build configuration. Do not prefix these with VITE_.
API_PROXY_TARGET=https://your-nexedge-api.onrender.com
CDN_PROXY_TARGET=https://nexedge-cdn.your-subdomain.workers.dev
